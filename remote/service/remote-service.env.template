# Copy to ~/Library/Application Support/LotsMemeX/remote-managed/remote-service.env and chmod 0600.
# Replace every placeholder. Never commit or print the resulting file.
MEMEX_REMOTE_REPOSITORY_ROOT='__CANONICAL_REPOSITORY_ROOT__'
MEMEX_REMOTE_EXPECTED_COMMIT='__REVIEWED_40_HEX_COMMIT__'
MEMEX_REMOTE_NODE='__PINNED_NODE_EXECUTABLE__'
MEMEX_RELAY_ADMISSION_ROOT='__FRESH_32_BYTE_BASE64URL_SECRET__'
MEMEX_REMOTE_RELAY_PORT='__HIGH_LOOPBACK_PORT__'
MEMEX_AGENT_SOCKET='__OWNER_AGENT_SOCKET__'
MEMEX_CLOUDFLARED_EXECUTABLE='__PINNED_CLOUDFLARED_EXECUTABLE__'
MEMEX_CLOUDFLARED_CONFIG='__OWNER_CLOUDFLARED_CONFIG__'
MEMEX_CLOUDFLARED_CREDENTIALS='__OWNER_CLOUDFLARED_CREDENTIALS__'
# Your own deployment: the HTTPS origin serving the web client, the client URL
# under it, and the relay hostname exposed by the tunnel.
MEMEX_REMOTE_BROWSER_ORIGIN='https://__WEB_HOST__'
MEMEX_REMOTE_WEB_CLIENT_URL='https://__WEB_HOST__/__CLIENT_PATH__'
MEMEX_REMOTE_RELAY_HOSTNAME='__RELAY_HOST__'
MEMEX_REMOTE_RELAY_URL='wss://__RELAY_HOST__/relay'
# Optional. Keychain item that holds the Mac bridge identity; defaults to
# com.lotsmemex.remote. To keep an existing pairing, set the old service name
# in MEMEX_REMOTE_KEYCHAIN_LEGACY_SERVICE: it is copied once, never deleted.
# MEMEX_REMOTE_KEYCHAIN_SERVICE='com.lotsmemex.remote'
# MEMEX_REMOTE_KEYCHAIN_LEGACY_SERVICE=''
